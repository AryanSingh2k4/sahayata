# ==========================================
# SAHAYATA — Optional Cloud Configuration
# (The application runs 100% locally out-of-the-box with zero required keys)
# ==========================================

# Port (Default: 3000)
PORT=3000

# Next.js Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [OPTIONAL] Supabase Cloud Database (for production persistent storage)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# [OPTIONAL] Upstash QStash (for serverless asynchronous workers)
# QSTASH_URL=https://qstash.upstash.io/v2/publish
# QSTASH_TOKEN=your-qstash-token
# QSTASH_CURRENT_SIGNING_KEY=your-signing-key
# QSTASH_NEXT_SIGNING_KEY=your-next-signing-key

# [OPTIONAL] Twilio / Gupshup WhatsApp Business Webhook
# WHATSAPP_API_KEY=your-whatsapp-api-key
# WHATSAPP_PHONE_NUMBER_ID=your-phone-id
